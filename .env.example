BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_name_here

ENABLE_CASHE=1
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
CACHE_CLEAN_INTERVAL_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=45
MAX_VIDEO_SIZE_MB=48
MAX_PHOTO_COUNT=35
MAX_PHOTO_SIZE_MB=10
PHOTO_ALBUM_CHUNK_SIZE=10
PHOTO_CAPTION_TEMPLATE=Original: {url}

TELEGRAM_UPLOAD_TIMEOUT_SECONDS=120
TELEGRAM_UPLOAD_RETRIES=3

TIKWM_API_KEY=your_tikwm_api_key_here
TIKWM_HD_QUALITY=1

TELEGRAM_PROXY=

DUMP_CHAT_ID=-1001234567890

TIKTOK_DEBUG_INLINE_SLIDES=0
TIKTOK_DEBUG_INLINE_FULL=0